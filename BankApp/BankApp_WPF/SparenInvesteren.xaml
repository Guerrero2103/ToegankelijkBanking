<Window x:Class="BankApp_WPF.SparenInvesteren"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Sparen en Investeren"
        Background="#000000"
        Height="700" Width="800">

    <Grid Margin="40">

        <!-- Terug-knop linksboven -->
        <Button x:Name="BtnTerug"
                Width="140"
                Height="60"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#FFD700"
                BorderThickness="0"
                Cursor="Hand"
                Click="BtnTerug_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            BorderThickness="0" 
                            CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="←" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Terug" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <!-- Titel -->
        <TextBlock Text="Sparen en Investeren"
                   FontSize="28"
                   Foreground="White"
                   Margin="0,100,0,0"
                   HorizontalAlignment="Left"/>

        <!-- Hoofdcontent -->
        <StackPanel VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Margin="0,180,0,0"
                    Width="600">

            <!-- Sparen knop -->
            <Button Background="#00A83C"
                    Foreground="White"
                    FontSize="26"
                    FontWeight="Bold"
                    Height="110"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,10,0,0"
                    Click="BtnSparen_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="#00D46B" 
                                BorderThickness="2" 
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="💰" FontSize="26" Margin="0,0,10,0"/>
                    <TextBlock Text="Sparen" FontSize="26" FontWeight="Bold"/>
                </StackPanel>
            </Button>

            <!-- Investeren knop -->
            <Button Background="#A020F0"
                    Foreground="White"
                    FontSize="26"
                    FontWeight="Bold"
                    Height="110"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,10,0,0"
                    Click="BtnInvesteren_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="#C868F5" 
                                BorderThickness="2" 
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📈" FontSize="26" Margin="0,0,10,0"/>
                    <TextBlock Text="Investeren" FontSize="26" FontWeight="Bold"/>
                </StackPanel>
            </Button>

            <!-- Terug naar hoofdpagina knop -->
            <Button Background="#FFD700"
                    Foreground="Black"
                    FontSize="24"
                    FontWeight="Bold"
                    Height="100"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,20,0,0"
                    Click="BtnTerugHoofd_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="0" 
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="←" FontSize="28" FontWeight="Bold" Margin="0,0,10,0"/>
                    <TextBlock Text="Terug naar hoofdpagina" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
            </Button>

        </StackPanel>
    </Grid>
</Window>
