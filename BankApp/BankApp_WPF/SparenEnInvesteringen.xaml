<Window x:Class="BankingApp.SparenEnInvesteringen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sparen en Investeren" 
        Height="750" 
        Width="900"
        Background="#000000"
        WindowStartupLocation="CenterScreen">
    
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========== HEADER ========== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,40">
            
            <!-- Terug Knop (bovenkant) -->
            <Button x:Name="BackButtonTop" 
                    Height="60" 
                    Width="180"
                    FontSize="20"
                    FontWeight="Bold"
                    Background="#FACC15"
                    Foreground="Black"
                    BorderBrush="#FACC15"
                    BorderThickness="4"
                    Cursor="Hand"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,25">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="←" FontSize="24" Margin="0,0,10,0"/>
                    <TextBlock Text="Terug" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Pagina Titel -->
            <TextBlock Text="Sparen en Investeren" 
                       FontSize="48" 
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- ========== MAIN CONTENT ========== -->
        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ========== SPAREN KNOP ========== -->
            <Button x:Name="SavingsButton" 
                    Grid.Row="0"
                    Height="120" 
                    Width="600"
                    FontSize="28"
                    FontWeight="Bold"
                    Background="#16A34A"
                    Foreground="White"
                    BorderBrush="#22C55E"
                    BorderThickness="4"
                    Cursor="Hand"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
                <Button.Effect>
                    <DropShadowEffect Color="Black" 
                                    Direction="270" 
                                    ShadowDepth="3" 
                                    BlurRadius="10" 
                                    Opacity="0.5"/>
                </Button.Effect>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="🐷" 
                             FontSize="40" 
                             HorizontalAlignment="Center"
                             Margin="0,0,0,10"/>
                    <TextBlock Text="Sparen" 
                             FontSize="28"
                             FontWeight="Bold"
                             HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- ========== INVESTEREN KNOP ========== -->
            <Button x:Name="InvestmentsButton" 
                    Grid.Row="2"
                    Height="120" 
                    Width="600"
                    FontSize="28"
                    FontWeight="Bold"
                    Background="#9333EA"
                    Foreground="White"
                    BorderBrush="#A855F7"
                    BorderThickness="4"
                    Cursor="Hand"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
                <Button.Effect>
                    <DropShadowEffect Color="Black" 
                                    Direction="270" 
                                    ShadowDepth="3" 
                                    BlurRadius="10" 
                                    Opacity="0.5"/>
                </Button.Effect>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📈" 
                             FontSize="40" 
                             HorizontalAlignment="Center"
                             Margin="0,0,0,10"/>
                    <TextBlock Text="Investeren" 
                             FontSize="28"
                             FontWeight="Bold"
                             HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- ========== TERUG NAAR HOOFDPAGINA KNOP ========== -->
            <Button x:Name="BackButtonMain" 
                    Grid.Row="4"
                    Height="80" 
                    Width="600"
                    FontSize="24"
                    FontWeight="Bold"
                    Background="#FACC15"
                    Foreground="Black"
                    BorderBrush="#FACC15"
                    BorderThickness="4"
                    Cursor="Hand">
                <StackPanel Orientation="Horizontal" 
                          HorizontalAlignment="Center">
                    <TextBlock Text="←" 
                             FontSize="32" 
                             Margin="0,0,15,0"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="Terug naar hoofdpagina" 
                             VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- ========== KEYBOARD HINT ========== -->
            <Border Grid.Row="6" 
                    Background="#1F2937" 
                    BorderBrush="#374151"
                    BorderThickness="2"
                    CornerRadius="8"
                    Padding="20"
                    Width="600"
                    HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Sneltoetsen:" 
                             FontSize="16" 
                             FontWeight="Bold"
                             Foreground="#D1D5DB"
                             HorizontalAlignment="Center"
                             Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Druk op " 
                                 FontSize="16" 
                                 Foreground="#D1D5DB"
                                 VerticalAlignment="Center"/>
                        <Border Background="#374151" 
                                BorderBrush="#4B5563"
                                BorderThickness="2"
                                CornerRadius="6"
                                Padding="8,4"
                                Margin="5,0">
                            <TextBlock Text="Z" 
                                     FontSize="16" 
                                     FontWeight="Bold"
                                     Foreground="White"/>
                        </Border>
                        <TextBlock Text=" om terug te gaan" 
                                 FontSize="16" 
                                 Foreground="#D1D5DB"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</Window>