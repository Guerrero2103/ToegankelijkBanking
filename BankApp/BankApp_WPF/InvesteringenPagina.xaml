<Window x:Class="BankApp_WPF.InvesteringenPagina"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BankApp_WPF"
        mc:Ignorable="d"
        Title="InvesteringenPagina"
        Height="900"
        Width="1600"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#000000"
        KeyDown="Window_KeyDown">


    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="20">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Investment Card Style -->
        <Style x:Key="InvestmentCard" TargetType="Border">
            <Setter Property="Background" Value="#1a1a1a"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="25"/>
            <Setter Property="Margin" Value="0,15"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#FFD700"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="297*"/>
            <RowDefinition Height="137*"/>
        </Grid.RowDefinitions>
        <!-- Top Bar -->
        <Border Background="#000000"
                Height="80"
                VerticalAlignment="Top"
                Padding="40,0">
            <Grid>
                <Button Content="← Terug"
                        Background="#FF6347"
                        Foreground="White"
                        FontSize="16"
                        FontWeight="Bold"
                        Width="120"
                        Height="50"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Click="BtnTerug_Click"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="10">
                                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Label Content="Mijn Investeringen"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Margin="0,80,0,0"
                      VerticalScrollBarVisibility="Auto" Background="#000000" Grid.RowSpan="2">
            <StackPanel MaxWidth="1000"
                        Margin="40"
                        VerticalAlignment="Top">

                <!-- Totaal Investering Card -->
                <Border Background="#1E90FF"
                        CornerRadius="15"
                        Padding="30"
                        Margin="0,0,0,30">
                    <StackPanel>
                        <Label Content="Totaal Geïnvesteerd"
                               FontSize="18"
                               Foreground="White"
                               Margin="0,0,0,10"/>
                        <Label Content="€45,500.00"
                               FontSize="48"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,20"/>
                        <Label Content="Rendement: +€2,450.75 (5.4%)"
                               FontSize="16"
                               Foreground="#E0E0E0"/>
                    </StackPanel>
                </Border>

                <!-- Investeringen Titel -->
                <Label Content="Uw Beleggingsportefeuille"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,20,0,20"/>

                <!-- Investering 1 -->
                <Border Style="{StaticResource InvestmentCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Label Content="Indexfonds Europa (VEUR)"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,0,0,10"/>
                            <Label Content="Aandelen"
                                   FontSize="14"
                                   Foreground="#FFD700"
                                   Margin="0,0,0,10"/>
                            <Label Content="Ingelegde bedrag: €15,000.00"
                                   FontSize="14"
                                   Foreground="#E0E0E0"
                                   Margin="0,0,0,5"/>
                            <Label Content="Huidige waarde: €16,200.00"
                                   FontSize="14"
                                   Foreground="#32CD32"
                                   Margin="0,0,0,5"/>
                            <Label Content="Winst: €1,200.00 (+8.0%)"
                                   FontSize="14"
                                   Foreground="#90EE90"
                                   Margin="0,0,0,10"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="30,0,0,0">
                            <Button Content="Details"
                                    Background="#1E90FF"
                                    Style="{StaticResource ModernButton}"
                                    Width="120"
                                    Height="40"
                                    Margin="0,0,0,10"
                                    Click="BtnDetails_Click"
                                    AutomationProperties.Name="Details knop"/>
                            <Button Content="Verkopen"
                                    Background="#FF6347"
                                    Style="{StaticResource ModernButton}"
                                    Width="120"
                                    Height="40"
                                    Click="BtnVerkopen_Click"
                                    AutomationProperties.Name="Verkopen knop"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Investering 2 -->
                <Border Style="{StaticResource InvestmentCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Label Content="Obligaties Staatsbank"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,0,0,10"/>
                            <Label Content="Vastrentend"
                                   FontSize="14"
                                   Foreground="#FFD700"
                                   Margin="0,0,0,10"/>
                            <Label Content="Ingelegde bedrag: €20,000.00"
                                   FontSize="14"
                                   Foreground="#E0E0E0"
                                   Margin="0,0,0,5"/>
                            <Label Content="Huidige waarde: €20,800.00"
                                   FontSize="14"
                                   Foreground="#32CD32"
                                   Margin="0,0,0,5"/>
                            <Label Content="Winst: €800.00 (+4.0%)"
                                   FontSize="14"
                                   Foreground="#90EE90"
                                   Margin="0,0,0,10"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="30,0,0,0">
                            <Button Content="Details"
                                    Background="#1E90FF"
                                    Style="{StaticResource ModernButton}"
                                    Width="120"
                                    Height="40"
                                    Margin="0,0,0,10"
                                    Click="BtnDetails_Click"
                                    AutomationProperties.Name="Details knop"/>
                            <Button Content="Verkopen"
                                    Background="#FF6347"
                                    Style="{StaticResource ModernButton}"
                                    Width="120"
                                    Height="40"
                                    Click="BtnVerkopen_Click"
                                    AutomationProperties.Name="Verkopen knop"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Investering 3 -->
                <Border Style="{StaticResource InvestmentCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Label Content="Spaarrekening Rendement"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,0,0,10"/>
                            <Label Content="Sparen"
                                   FontSize="14"
                                   Foreground="#FFD700"
                                   Margin="0,0,0,10"/>
                            <Label Content="Ingelegde bedrag: €10,500.00"
                                   FontSize="14"
                                   Foreground="#E0E0E0"
                                   Margin="0,0,0,5"/>
                            <Label Content="Huidige waarde: €10,500.00"
                                   FontSize="14"
                                   Foreground="#FFD700"
                                   Margin="0,0,0,5"/>
                            <Label Content="Rente: +€450.75 (4.3% per jaar)"
                                   FontSize="14"
                                   Foreground="#90EE90"
                                   Margin="0,0,0,10"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="30,0,0,0">
                            <Button Content="Details"
                                    Background="#1E90FF"
                                    Style="{StaticResource ModernButton}"
                                    Width="120"
                                    Height="40"
                                    Margin="0,0,0,10"
                                    Click="BtnDetails_Click"
                                    AutomationProperties.Name="Details knop"/>
                            <Button Content="Opnemen"
                                    Background="#FF9900"
                                    Style="{StaticResource ModernButton}"
                                    Width="120"
                                    Height="40"
                                    Click="BtnOpnemen_Click"
                                    AutomationProperties.Name="Opnemen knop"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Info Label -->
                <TextBlock Text="Tip: Diversificatie en regelmatig investeren helpen bij het bereiken van uw financiële doelen."
                           FontSize="14"
                           Foreground="#B0B0B0"
                           Margin="0,30,0,30"
                           TextWrapping="Wrap"/>

                <!-- Action Buttons -->
                <Grid Margin="0,20,0,40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Nieuw Beleggen"
                            Background="#32CD32"
                            Style="{StaticResource ModernButton}"
                            Click="BtnNieuwBeleggen_Click"
                            AutomationProperties.Name="Nieuw beleggen knop"/>

                    <Button Grid.Column="2"
                            Content="Historie Bekijken"
                            Background="#1E90FF"
                            Style="{StaticResource ModernButton}"
                            Click="BtnHistorie_Click"
                            AutomationProperties.Name="Historie knop"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
