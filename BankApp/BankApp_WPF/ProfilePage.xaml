<Window x:Class="ProfileApp.ProfilePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profiel Raadplegen" 
        Height="950" 
        Width="1000"
        Background="#000000"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========== HEADER ========== -->
        <Grid Grid.Row="0" Margin="0,0,0,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Terug Knop -->
            <Button x:Name="BackButton" 
                    Grid.Column="0"
                    Height="60" 
                    Width="180"
                    FontSize="20"
                    FontWeight="Bold"
                    Background="White"
                    Foreground="Black"
                    BorderBrush="White"
                    BorderThickness="4"
                    Cursor="Hand"
                    Padding="10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="?" FontSize="24" Margin="0,0,10,0"/>
                    <TextBlock Text="Terug" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Titel -->
            <TextBlock Grid.Column="1" 
                       Text="Profiel Raadplegen" 
                       FontSize="36" 
                       FontWeight="Bold"
                       Foreground="White"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>

            <!-- Voice Toggle Knop -->
            <Button x:Name="VoiceToggleButton" 
                    Grid.Column="2"
                    Height="60" 
                    Width="60"
                    FontSize="32"
                    Background="#FACC15"
                    Foreground="Black"
                    BorderBrush="#FACC15"
                    BorderThickness="4"
                    Cursor="Hand"
                    Content="??"/>
        </Grid>

        <!-- ========== SCROLLABLE CONTENT ========== -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- ========== PROFIEL INFORMATIE CARD ========== -->
                <Border Background="#1C1C1C" 
                        BorderBrush="#374151" 
                        BorderThickness="4" 
                        CornerRadius="12" 
                        Padding="40"
                        Margin="0,0,0,30">
                    <StackPanel>
                        <!-- Card Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                            <Border Background="#9333EA" 
                                    Width="50" 
                                    Height="50" 
                                    CornerRadius="25"
                                    Margin="0,0,15,0">
                                <TextBlock Text="??" 
                                         FontSize="28" 
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Mijn Gegevens" 
                                     FontSize="32" 
                                     FontWeight="Bold"
                                     Foreground="White"
                                     VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Email Veld -->
                        <TextBlock Text="Email" 
                                 FontSize="20" 
                                 FontWeight="SemiBold"
                                 Foreground="White" 
                                 Margin="0,0,0,8"/>
                        <TextBox x:Name="EmailTextBox" 
                               Text="gebruiker@example.com"
                               Height="60" 
                               FontSize="18"
                               Background="#1F2937"
                               Foreground="White"
                               BorderBrush="#4B5563"
                               BorderThickness="4"
                               Padding="15,0"
                               VerticalContentAlignment="Center"
                               Margin="0,0,0,20"/>

                        <!-- Wachtwoord Veld -->
                        <TextBlock FontSize="20" 
                                 FontWeight="SemiBold"
                                 Foreground="White" 
                                 Margin="0,0,0,8">
                            <Run Text="Wachtwoord"/>
                            <Run Text=" (optioneel - alleen invullen om te wijzigen)" 
                                 FontSize="16" 
                                 FontWeight="Normal"
                                 Foreground="#9CA3AF"/>
                        </TextBlock>
                        <PasswordBox x:Name="PasswordBox" 
                                   Height="60" 
                                   FontSize="18"
                                   Background="#1F2937"
                                   Foreground="White"
                                   BorderBrush="#4B5563"
                                   BorderThickness="4"
                                   Padding="15,0"
                                   VerticalContentAlignment="Center"
                                   Margin="0,0,0,20"/>

                        <!-- Wachtwoord Bevestigen Veld -->
                        <TextBlock Text="Wachtwoord Bevestigen" 
                                 FontSize="20" 
                                 FontWeight="SemiBold"
                                 Foreground="White" 
                                 Margin="0,0,0,8"/>
                        <PasswordBox x:Name="ConfirmPasswordBox" 
                                   Height="60" 
                                   FontSize="18"
                                   Background="#1F2937"
                                   Foreground="White"
                                   BorderBrush="#4B5563"
                                   BorderThickness="4"
                                   Padding="15,0"
                                   VerticalContentAlignment="Center"
                                   Margin="0,0,0,20"/>

                        <!-- Telefoonnummer Veld -->
                        <TextBlock Text="Telefoonnr." 
                                 FontSize="20" 
                                 FontWeight="SemiBold"
                                 Foreground="White" 
                                 Margin="0,0,0,8"/>
                        <TextBox x:Name="PhoneTextBox" 
                               Text="+32 123 45 67 89"
                               Height="60" 
                               FontSize="18"
                               Background="#1F2937"
                               Foreground="White"
                               BorderBrush="#4B5563"
                               BorderThickness="4"
                               Padding="15,0"
                               VerticalContentAlignment="Center"
                               Margin="0,0,0,20"/>

                        <!-- IBAN Veld (Read-only) -->
                        <TextBlock FontSize="20" 
                                 FontWeight="SemiBold"
                                 Foreground="White" 
                                 Margin="0,0,0,8">
                            <Run Text="IBAN"/>
                            <Run Text=" (Alleen lezen)" 
                                 FontSize="16" 
                                 FontWeight="Normal"
                                 Foreground="#9CA3AF"/>
                        </TextBlock>
                        <TextBox x:Name="IbanTextBox" 
                               Text="BE68 5390 0754 7034"
                               Height="60" 
                               FontSize="18"
                               Background="#374151"
                               Foreground="#9CA3AF"
                               BorderBrush="#4B5563"
                               BorderThickness="4"
                               Padding="15,0"
                               VerticalContentAlignment="Center"
                               IsReadOnly="True"
                               Cursor="No"
                               Margin="0,0,0,20"/>

                        <!-- Geboortedatum Veld -->
                        <TextBlock Text="Geboortedatum" 
                                 FontSize="20" 
                                 FontWeight="SemiBold"
                                 Foreground="White" 
                                 Margin="0,0,0,8"/>
                        <DatePicker x:Name="BirthdatePicker" 
                                  SelectedDate="1990-01-15"
                                  Height="60" 
                                  FontSize="18"
                                  Background="#1F2937"
                                  Foreground="White"
                                  BorderBrush="#4B5563"
                                  BorderThickness="4"
                                  Padding="15,0"
                                  VerticalContentAlignment="Center"
                                  Margin="0,0,0,20"/>

                        <!-- Adres Veld -->
                        <TextBlock Text="Adres" 
                                 FontSize="20" 
                                 FontWeight="SemiBold"
                                 Foreground="White" 
                                 Margin="0,0,0,8"/>
                        <TextBox x:Name="AddressTextBox" 
                               Text="Kerkstraat 123, 1000 Brussel"
                               Height="60" 
                               FontSize="18"
                               Background="#1F2937"
                               Foreground="White"
                               BorderBrush="#4B5563"
                               BorderThickness="4"
                               Padding="15,0"
                               VerticalContentAlignment="Center"
                               Margin="0,0,0,30"/>

                        <!-- Opslaan Knop -->
                        <Button x:Name="SaveButton" 
                              Height="80" 
                              FontSize="24"
                              FontWeight="Bold"
                              Background="#9333EA"
                              Foreground="White"
                              BorderBrush="#A855F7"
                              BorderThickness="4"
                              Cursor="Hand"
                              Content="Wijzigingen Opslaan"/>
                    </StackPanel>
                </Border>

                <!-- ========== PROFIEL VERWIJDEREN CARD ========== -->
                <Border Background="#45