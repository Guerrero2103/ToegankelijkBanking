<Window x:Class="BankApp_WPF.AdminPagina"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BankApp_WPF"
        mc:Ignorable="d"
        Title="AdminPagina" Height="450" Width="800">

    <Grid Background="#000000">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Terug knop bovenaan -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,15" Background="#000000">
            <Button x:Name="BackButton" 
                    Width="50" Height="41" 
                    Background="#a855f7" 
                    
                    Foreground="White"
                    FontSize="20"
                    Click="BtnTerug_Click"
                    Cursor="Hand"
                    Padding="0">
                ←
            </Button>
        </StackPanel>

        <!-- Titel en beschrijving -->
        <StackPanel Grid.Row="1" Margin="20,0" Background="#000000">
            <TextBlock Text="Admin Panel" 
                       Foreground="White" 
                       FontSize="24" 
                       FontWeight="Bold"/>
            <TextBlock Text="Beheer klanten, kaarten en aanvragen" 
                       Foreground="#999999" 
                       FontSize="12" 
                       Margin="0,5,0,0"/>
            
        </StackPanel>

        <!-- Tabbladen -->
        <TabControl Grid.Row="2" 
                    Background="Transparent" 
                    Foreground="White"
                    Margin="0,0,0,0">


            <!-- Klanten tab -->
            <TabItem Header="Klanten" Height="38" VerticalAlignment="Top" Background="#1E2939" Foreground="#FFFFFF">
                <TabItem.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                
                                <ControlTemplate TargetType="TabItem">
                                    <Border Name="Border" 
                                            Background="#2a3142" 
                                            BorderBrush="#3a4152" 
                                            BorderThickness="1"
                                            Margin="0,0,5,0"
                                            Padding="20,10">
                                        <ContentPresenter ContentSource="Header"/>
                                        
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabItem.Resources>

                <Grid Background="#1a1f2e" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="300"/>
                        <RowDefinition Height="*"/>
                        
                    </Grid.RowDefinitions>

                    <!-- Formulier voor nieuwe klant -->
                    <Border Grid.Row="0" 
                            Background="#2a3142" 
                            BorderBrush="#3a4152" 
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="20">
                        <StackPanel>
                            
                            <TextBlock Text="Nieuwe klant toevoegen" 
                                       Foreground="White" 
                                       FontSize="14" 
                                       FontWeight="Bold"
                                       Margin="0,0,0,15"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Voornaam -->
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Naam *" Foreground="White" FontSize="12" Margin="0,0,0,5"/>
                                    <TextBox x:Name="NameTextBox" 
                                             
                                             Background="#1f2533" 
                                             Foreground="White"
                                             BorderBrush="#3a4152"
                                             BorderThickness="1"
                                             Padding="10,8"
                                             Height="35"/>
                                </StackPanel>

                                <!-- Email -->
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="Email *" Foreground="White" FontSize="12" Margin="0,0,0,5"/>
                                    <TextBox x:Name="EmailTextBox" 
                                             Background="#1f2533" 
                                             Foreground="White"
                                             BorderBrush="#3a4152"
                                             BorderThickness="1"
                                             Padding="10,8"
                                             Height="35"/>
                                    
                                </StackPanel>

                                <!-- Rekeningnummer -->
                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="Rekeningnummer *" Foreground="White" FontSize="12" Margin="0,0,0,5"/>
                                    <TextBox x:Name="AccountNumberTextBox" 
                                             Background="#1f2533" 
                                             Foreground="White"
                                             BorderBrush="#3a4152"
                                             BorderThickness="1"
                                             Padding="10,8"
                                             Height="35"/>
                                    
                                </StackPanel>

                                <!-- Saldo -->
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Text="Saldo (€)" Foreground="White" FontSize="12" Margin="0,0,0,5"/>
                                    <TextBox x:Name="BalanceTextBox" 
                                             Background="#1f2533" 
                                             
                                             Foreground="White"
                                             BorderBrush="#3a4152"
                                             BorderThickness="1"
                                             Padding="10,8"
                                             Height="35"
                                             Text="0"/>
                                    
                                    
                                
                                </StackPanel>

                                <!-- Rol -->
                                <StackPanel Grid.Row="4" Grid.Column="0">
                                    <TextBlock Text="Rol" Foreground="White" FontSize="12" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="RoleComboBox" 
                                              Background="#1f2533" 
                                              Foreground="White"
                                              BorderBrush="#3a4152"
                                              BorderThickness="1"
                                              Padding="10,8"
                                              Height="35">
                                        <ComboBoxItem>Klant</ComboBoxItem>
                                        <ComboBoxItem>Beheerder</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Knop toevoegen -->
                                <Button Grid.Row="4" Grid.Column="2"
                                        Background="#22c55e" 
                                        
                                        Foreground="White"
                                        FontWeight="Bold"
                                        Padding="20,8"
                                        Height="35"
                                        Cursor="Hand">
                                    👤 Klant toevoegen
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Klanten overzicht -->
                    <Border Grid.Row="1" 
                            Background="#2a3142" 
                            BorderBrush="#3a4152" 
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="20"
                            Margin="0,15,0,0">
                        
                        
                        <StackPanel>
                            <TextBlock Text="Klanten overzicht (3)" 
                                       Foreground="White" 
                                       FontSize="14" 
                                       FontWeight="Bold"
                                       Margin="0,0,0,15"/>

                            <ListBox Background="Transparent" BorderThickness="0">
                                <!-- Klant 1 -->
                                <Border Background="#1f2533" 
                                        BorderBrush="#3a4152" 
                                        BorderThickness="1"
                                        
                                        CornerRadius="5"
                                        Padding="15"
                                        Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Jan de Vries" 
                                                       Foreground="White" 
                                                       FontWeight="Bold"
                                                       FontSize="12"/>
                                            <TextBlock Text="jan@example.com" Foreground="#999999" FontSize="11" Margin="0,3,0,0"/>
                                            <TextBlock Text="BE91ABNA0417164300" Foreground="#999999" FontSize="11" Margin="0,3,0,0"/>
                                            <TextBlock Text="Saldo: €2500.50" Foreground="#22c55e" FontSize="11" Margin="0,3,0,0"/>
                                            <TextBlock Text="Klant" Foreground="#888888" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Background="#3b82f6" 
                                                    Foreground="White"
                                                    Padding="15,8"
                                                    Margin="5"
                                                    Cursor="Hand">
                                                ✏️ Bewerken
                                            </Button>
                                            <Button Background="#ec4899" 
                                                    Foreground="White"
                                                    Padding="15,8"
                                                    Margin="5"
                                                    Cursor="Hand">
                                                🗑️ Verwijderen
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Klant 2 -->
                                <Border Background="#1f2533" 
                                        BorderBrush="#3a4152" 
                                        BorderThickness="1"
                                        
                                        CornerRadius="5"
                                        Padding="15"
                                        Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            
                                            <TextBlock Text="Maria Janssen" 
                                                       Foreground="White" 
                                                       FontWeight="Bold"
                                                       FontSize="12"/>
                                            <TextBlock Text="maria@example.com" Foreground="#999999" FontSize="11" Margin="0,3,0,0"/>
                                            <TextBlock Text="BE20INGB0001234567" Foreground="#999999" FontSize="11" Margin="0,3,0,0"/>
                                            <TextBlock Text="Saldo: €5420.75" Foreground="#22c55e" FontSize="11" Margin="0,3,0,0"/>
                                            <TextBlock Text="Klant" Foreground="#888888" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            
                                            
                                            <Button Background="#3b82f6" 
                                                    Foreground="White"
                                                    
                                                    Padding="15,8"
                                                    Margin="5"
                                                    Cursor="Hand">
                                                ✏️ Bewerken
                                            </Button>
                                            <Button Background="#ec4899" 
                                                    
                                                    Foreground="White"
                                                    Padding="15,8"
                                                    Margin="5"
                                                    Cursor="Hand">
                                                🗑️ Verwijderen
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Gebruikers tab -->
            <TabItem Header="Gebruikers" Height="40" Margin="-2,-2,-2,0" VerticalAlignment="Top" Background="#1E2939" Foreground="#FFFFFF" >
                <Grid Background="#1a1f2e" Margin="20">
                    
                    
                    <Border Background="#2a3142" 
                            BorderBrush="#3a4152" 
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="20">
                        <StackPanel>
                            
                            
                            <TextBlock Text="Gebruikersinformatie raadplegen" 
                                       Foreground="White" 
                                       
                                       FontSize="14" 
                                       FontWeight="Bold"
                                       Margin="0,0,0,15"/>

                            <ListBox Background="Transparent" BorderThickness="0">
                                <!-- Gebruiker 1 -->
                                <Border Background="#1f2533" 
                                        BorderBrush="#3a4152" 
                                        BorderThickness="1"
                                        
                                        CornerRadius="5"
                                        Padding="15"
                                        Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            
                                            <TextBlock Text="Jan de Vries" Foreground="White" FontWeight="Bold"/>
                                            <TextBlock Text="Email: jan@example.com" Foreground="#999999" FontSize="11" Margin="0,3,0,0"/>
                                            <TextBlock Text="Rekeningnummer: BE91ABNA0417164300" Foreground="#999999" FontSize="11" Margin="0,3,0,0"/>
                                            <TextBlock Text="Rol: Klant" Foreground="#999999" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Account status" Foreground="White" FontWeight="Bold"/>
                                            <TextBlock Text="Saldo: €2500.50" Foreground="#22c55e" FontSize="11" Margin="0,3,0,0"/>
                                            <TextBlock Text="Kaartstatus: Actief" Foreground="#22c55e" FontSize="11" Margin="0,3,0,0"/>
                                            <TextBlock Text="Account ID: 1" Foreground="#999999" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Gebruiker 2 -->
                                <Border Background="#1f2533" 
                                        BorderBrush="#3a4152" 
                                        BorderThickness="1"
                                        
                                        CornerRadius="5"
                                        Padding="15"
                                        Margin="0,0,0,10">
                                    
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            
                                            <TextBlock Text="Maria Janssen" Foreground="White" FontWeight="Bold"/>
                                            <TextBlock Text="Email: maria@example.com" Foreground="#999999" FontSize="11" Margin="0,3,0,0"/>
                                            <TextBlock Text="Rekeningnummer: BE20INGB0001234567" Foreground="#999999" FontSize="11" Margin="0,3,0,0"/>
                                            <TextBlock Text="Rol: Klant" Foreground="#999999" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            
                                            <TextBlock Text="Account status" Foreground="White" FontWeight="Bold"/>
                                            <TextBlock Text="Saldo: €5420.75" Foreground="#22c55e" FontSize="11" Margin="0,3,0,0"/>
                                            <TextBlock Text="Kaartstatus: Actief" Foreground="#22c55e" FontSize="11" Margin="0,3,0,0"/>
                                            <TextBlock Text="Account ID: 2" Foreground="#999999" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Kaarten tab -->
            <TabItem Header="Kaarten" Background="#1E2939" Foreground="#FFFFFF" Margin="8,-2,-13,0" >
                <Grid Background="#1a1f2e" Margin="20">
                    <Border Background="#2a3142" 
                            BorderBrush="#3a4152" 
                            
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="20">
                        <StackPanel>
                            
                            <TextBlock Text="Kaart beheer - Card Stop" 
                                       Foreground="White" 
                                       
                                       FontSize="14" 
                                       FontWeight="Bold"
                                       Margin="0,0,0,15"/>

                            <ListBox Background="Transparent" BorderThickness="0">
                                <!-- Kaart 1 -->
                                <Border Background="#1f2533" 
                                        BorderBrush="#3a4152" 
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="15"
                                        Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Jan de Vries" Foreground="White" FontWeight="Bold"/>
                                            <TextBlock Text="BE91ABNA0417164300" Foreground="#999999" FontSize="11" Margin="0,3,0,0"/>
                                            <TextBlock Text="Status: Actief" Foreground="#22c55e" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Background="#fbbf24" 
                                                    Foreground="White"
                                                    Padding="15,8"
                                                    Margin="5"
                                                    Cursor="Hand">
                                                Bevriezen
                                            </Button>
                                            
                                            <Button Background="#ef4444" 
                                                    Foreground="White"
                                                    
                                                    Padding="15,8"
                                                    Margin="5"
                                                    Cursor="Hand">
                                                Blokkeren
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Kaart 2 -->
                                <Border Background="#1f2533" 
                                        BorderBrush="#3a4152" 
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="15"
                                        Margin="0,0,0,10">
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Maria Janssen" Foreground="White" FontWeight="Bold"/>
                                            <TextBlock Text="BE20INGB0001234567" Foreground="#999999" FontSize="11" Margin="0,3,0,0"/>
                                            <TextBlock Text="Status: Actief" Foreground="#22c55e" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Background="#fbbf24" 
                                                    Foreground="White"
                                                    
                                                    Padding="15,8"
                                                    Margin="5"
                                                    Cursor="Hand">
                                                Bevriezen
                                            </Button>
                                            <Button Background="#ef4444" 
                                                    Foreground="White"
                                                    Padding="15,8"
                                                    Margin="5"
                                                    Cursor="Hand">
                                                Blokkeren
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Aanvragen tab -->
            <TabItem Header="Aanvragen" Background="#1E2939" Foreground="#FFFFFF" Margin="17,-2,-21,0">
                <Grid Background="#1a1f2e" Margin="20">
                    <Border Background="#2a3142" 
                            BorderBrush="#3a4152" 
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="20">
                        
                        <StackPanel>
                            
                            
                            <TextBlock Text="Aanvragen beheren en goedkeuren" 
                                       Foreground="White" 
                                       FontSize="14" 
                                       FontWeight="Bold"
                                       Margin="0,0,0,15"/>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- Aanvraag 1 -->
                                    <Border Background="#1f2533" 
                                            BorderBrush="#3a4152" 
                                            BorderThickness="1"
                                            
                                            CornerRadius="5"
                                            Padding="15"
                                            Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0">
                                                
                                                <TextBlock Text="Jan de Vries" Foreground="White" FontWeight="Bold"/>
                                                <TextBlock Text="Type: Lening" Foreground="#999999" FontSize="11" Margin="0,3,0,0"/>
                                                <TextBlock Text="Datum: 2025-11-01" Foreground="#999999" FontSize="11" Margin="0,3,0,0"/>
                                                <TextBlock Text="Aanvraag voor persoonlijke lening van €15.000" Foreground="White" FontSize="11" Margin="0,5,0,0" FontWeight="Bold"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                                
                                                <Button Background="#fbbf24" 
                                                        Foreground="White"
                                                        
                                                        Padding="15,8"
                                                        Margin="5"
                                                        Cursor="Hand">
                                                    In behandeling
                                                </Button>
                                            </StackPanel>

                                            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="*"/>
                                                    
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0"
                                                        Background="#22c55e" 
                                                        Foreground="White"
                                                        Padding="20,8"
                                                        Cursor="Hand">
                                                    ✓ Goedkeuren
                                                </Button>

                                                <Button Grid.Column="2"
                                                        Background="#ef4444" 
                                                        Foreground="White"
                                                        Padding="20,8"
                                                        Cursor="Hand">
                                                    ✕ Afwijzen
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- Aanvraag 2 -->
                                    <Border Background="#1f2533" 
                                            BorderBrush="#3a4152" 
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            
                                            Padding="15"
                                            Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0">
                                                
                                                <TextBlock Text="Maria Janssen" Foreground="White" FontWeight="Bold"/>
                                                <TextBlock Text="Type: Kaart" Foreground="#999999" FontSize="11" Margin="0,3,0,0"/>
                                                <TextBlock Text="Datum: 2025-11-02" Foreground="#999999" FontSize="11" Margin="0,3,0,0"/>
                                                <TextBlock Text="Aanvraag voor nieuwe creditcard" Foreground="White" FontSize="11" Margin="0,5,0,0" FontWeight="Bold"/>
                                            
                                            </StackPanel>

                                            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                                <Button Background="#fbbf24" 
                                                        Foreground="White"
                                                        Padding="15,8"
                                                        Margin="5"
                                                        
                                                        Cursor="Hand">
                                                    In behandeling
                                                </Button>
                                            </StackPanel>

                                            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="*"/>
                                                    
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0"
                                                        Background="#22c55e" 
                                                        Foreground="White"
                                                        
                                                        Padding="20,8"
                                                        Cursor="Hand">
                                                    ✓ Goedkeuren
                                                </Button>

                                                <Button Grid.Column="2"
                                                        Background="#ef4444" 
                                                        
                                                        Foreground="White"
                                                        Padding="20,8"
                                                        Cursor="Hand">
                                                    ✕ Afwijzen
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>