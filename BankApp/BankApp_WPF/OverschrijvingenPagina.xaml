<Window x:Class="BankApp_WPF.OverschrijvingenPagina"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BankApp_WPF"
        mc:Ignorable="d"
        Title="OverschrijvingenPagina" Height="450" Width="800">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="20">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Input Field Style -->
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,10"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Top Bar -->
        <Border Background="#000000"
                Height="80"
                VerticalAlignment="Top"
                Padding="40,0">
            <Grid>
                <Button Content="← Terug"
                        Background="#FF6347"
                        Foreground="White"
                        FontSize="16"
                        FontWeight="Bold"
                        Width="120"
                        Height="50"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Click="BtnTerug_Click"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="10">
                                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Label Content="Overschrijving Maken"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Margin="0,80,0,0"
                      VerticalScrollBarVisibility="Auto" HorizontalAlignment="Right" Width="800" Background="#000000">
            <StackPanel MaxWidth="900"
                        Margin="40">

                <Border Background="#FFD700"
                        CornerRadius="20"
                        Padding="40"
                        Margin="0,20,0,30">
                    <StackPanel>
                        <Label Content="Vul de gegevens in"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#000000"
                               Margin="0,0,0,30"/>

                        <Label Content="IBAN van ontvanger"
                               FontSize="16"
                               Foreground="#000000"
                               Margin="0,0,0,5"/>
                        <TextBox x:Name="txtIban"
                                 Style="{StaticResource InputField}"
                                 Height="45"/>

                        <Label Content="Naam ontvanger"
                               FontSize="16"
                               Foreground="#000000"
                               Margin="0,20,0,5"/>
                        <TextBox x:Name="txtNaamOntvanger"
                                 Style="{StaticResource InputField}"
                                 Height="45"/>

                        <Label Content="Bedrag (€)"
                               FontSize="16"
                               Foreground="#000000"
                               Margin="0,20,0,5"/>
                        <TextBox x:Name="txtBedrag"
                                 Style="{StaticResource InputField}"
                                 Height="45"/>

                        <Label Content="Omschrijving"
                               FontSize="16"
                               Foreground="#000000"
                               Margin="0,20,0,5"/>
                        <TextBox x:Name="txtOmschrijving"
                                 Style="{StaticResource InputField}"
                                 Height="80"
                                 TextWrapping="Wrap"
                                 VerticalAlignment="Top"
                                 AcceptsReturn="True"/>

                        <Grid Margin="0,40,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Content="Annuleren"
                                    Background="#FF6347"
                                    Style="{StaticResource ModernButton}"
                                    Click="BtnAnnuleren_Click"
                                    AutomationProperties.Name="Annuleren knop"/>

                            <Button Grid.Column="2"
                                    Content="Verzenden →"
                                    Background="#32CD32"
                                    Style="{StaticResource ModernButton}"
                                    Click="BtnVerzenden_Click"
                                    AutomationProperties.Name="Verzenden knop"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
